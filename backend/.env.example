# Copy to .env and fill in. Never commit .env.

PORT=4000
NODE_ENV=development

# MongoDB Atlas free M0 cluster connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/make-my-marriage

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me

# How long a sign-in lasts, in days
SESSION_DAYS=7

# Where the React app runs; used for CORS and for links in emails
WEB_APP_URL=http://localhost:5173

# --- Email. With none of these set, emails are only printed in the terminal (not delivered). ---

# Option A (free, reaches anyone): Gmail. Turn on 2-Step Verification, then create an app
# password at https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Option B: Resend. The free plan only delivers to your own address until you verify a domain.
RESEND_API_KEY=

# Sender shown to people. With Gmail, use your Gmail address.
EMAIL_FROM=Make My Marriage <you@gmail.com>

# --- "Ask your wedding" assistant. Free key, no card: https://aistudio.google.com/apikey ---
# Without a key the Ask page says the assistant isn't set up yet.
GEMINI_API_KEY=
# Optional. Models to try in order, comma-separated. The free plan allows each one about
# 20 requests a day, so the next takes over when one runs out.
GEMINI_MODELS=gemini-2.5-flash-lite,gemini-3.5-flash-lite,gemini-3.5-flash

# --- Photo gallery. Free account at https://cloudinary.com; values are on the dashboard. ---
# Without them the Gallery says photo storage isn't set up yet.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
