# Copy to .env and fill in. Never commit .env.

PORT=4000
NODE_ENV=development

# MongoDB Atlas free M0 cluster connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/make-my-marriage

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me

# How long a sign-in lasts, in days
SESSION_DAYS=7

# Where the React app runs; used for CORS and for links in emails
WEB_APP_URL=http://localhost:5173

# --- Email. With none of these set, emails are only printed in the terminal (not delivered). ---

# Option A (free, reaches anyone): Gmail. Turn on 2-Step Verification, then create an app
# password at https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Option B: Resend. The free plan only delivers to your own address until you verify a domain.
RESEND_API_KEY=

# Sender shown to people. With Gmail, use your Gmail address.
EMAIL_FROM=Make My Marriage <you@gmail.com>
