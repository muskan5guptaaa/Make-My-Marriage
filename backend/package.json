{
  "name": "make-my-marriage-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "normalize-phones": "node --env-file-if-exists=.env scripts/normalize-phones.js",
    "eval": "node --env-file-if-exists=.env scripts/run-evals.js"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "express": "5.1.0",
    "express-rate-limit": "7.5.0",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.13.2",
    "nodemailer": "6.10.0",
    "resend": "4.2.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "mongodb-memory-server": "10.1.4",
    "supertest": "7.1.3"
  }
}
